

# ── API ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

LAUNCHPAD_PUBLIC_HOST=launchpad.app
# Where the web app lives, used for absolute redirects in dev
LAUNCHPAD_WEB_ORIGIN=http://localhost:5173

# ── Storage ───────────────────────────────────────────────────────────────────
# postgres | file | auto   (auto = Postgres if reachable, then a JSON file)
LAUNCHPAD_STORE=auto
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=launchpad
PGPASSWORD=launchpad
PGDATABASE=launchpad
LAUNCHPAD_PG_SSL=false
# Uploads and the JSON fallback store live here (created on boot, git-ignored)
LAUNCHPAD_STORAGE_DIR=apps/api/storage

# ── Generation ────────────────────────────────────────────────────────────────
# What writes the spec. 'auto' asks, in this order, and uses the built-in
# compiler if nothing answers: Gemini (only when GOOGLE_GEMINI_API_KEY is set) →
# LAUNCHPAD_LLM_BASE_URL (only when set) → LM Studio → Ollama.
#   auto      use whichever model server replies
#   gemini    require Gemini         llm      require LAUNCHPAD_LLM_BASE_URL
#   lmstudio  require LM Studio      ollama   require Ollama
#   gemini-openai  Gemini through its OpenAI-compatible shim (legacy keys)
#   local     never call out
LAUNCHPAD_AI_PROVIDER=auto

# LM Studio: load a model, then Developer → Start Server (default port 1234).
# Nothing else to configure — the model Launchpad uses is the one LM Studio has
# loaded. Pin it with LMSTUDIO_MODEL if you keep several around (the exact id
# from GET http://127.0.0.1:1234/v1/models).
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=
# Only needed if you ticked "require API key" on the LM Studio server.
LMSTUDIO_API_KEY=
# Generation budget, and how long to wait. A 30B model on a laptop is slow:
# the timeout is generous on purpose, and the run falls back to the compiler.
LAUNCHPAD_LM_MAX_TOKENS=2600
LAUNCHPAD_LM_TIMEOUT_MS=300000
LAUNCHPAD_LM_TEMPERATURE=0.4
# Set to 1 to also send response_format {"type":"json_object"} (JSON mode).
# Leave it blank if the model answers 400 — some GGUF builds refuse a grammar.
LAUNCHPAD_LM_JSON_MODE=
# 'off' stops Launchpad probing port 1234 at all on a machine without it.
LAUNCHPAD_LMSTUDIO=auto

# ── Gemini, from Google AI Studio (optional — the only one that calls out) ───
# NOT the block above: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are OAuth for
# signing people in. This is an API key for generativelanguage.googleapis.com,
# made at https://aistudio.google.com/apikey. If your shell already exports
# GEMINI_API_KEY for other tools: GOOGLE_GEMINI_API_KEY=$GEMINI_API_KEY
#
# With no key here, nothing changes: Gemini is skipped before any request is
# made and the local servers (or the compiler) do the work. With one, it goes
# first in 'auto' — a hosted model answers a 4k-token spec in seconds.
GOOGLE_GEMINI_API_KEY=
# A model id, or 'auto' to pick a flash from GET /v1beta/models for this key.
GEMINI_MODEL=gemini-2.5-flash
# The spec is one long JSON answer: this is the output ceiling, and the wait.
LAUNCHPAD_GEMINI_MAX_TOKENS=4000
LAUNCHPAD_GEMINI_TIMEOUT_MS=90000
LAUNCHPAD_GEMINI_TEMPERATURE=0.3
# Blank (default) asks for responseMimeType application/json. Set to off if a
# model ever refuses it; json-repair still strips fences and prose.
LAUNCHPAD_GEMINI_JSON_MODE=
# 'off' takes Gemini out of the ordering even when a key is present.
LAUNCHPAD_GEMINI=auto
# Only repoint these for a proxy or a gateway (or a test stub, which is what the
# API suite does — nothing in the tests reaches Google).
LAUNCHPAD_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LAUNCHPAD_GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Any other OpenAI-compatible server instead (vLLM, llama.cpp's server, a box
# on the LAN). Wins over LM Studio when set.
LAUNCHPAD_LLM_BASE_URL=
LAUNCHPAD_LLM_MODEL=
LAUNCHPAD_LLM_API_KEY=

# Ollama, if that is what you run.
OLLAMA_HOST=http://127.0.0.1:11434
# Blank means "first model Ollama reports"
OLLAMA_MODEL=
LAUNCHPAD_OLLAMA_TIMEOUT_MS=240000
LAUNCHPAD_OLLAMA_TEMPERATURE=0.4
LAUNCHPAD_OLLAMA_NUM_PREDICT=2600
OLLAMA_KEEP_ALIVE=10m
LAUNCHPAD_JSON_REPAIR_RETRIES=2

# ── Auth ──────────────────────────────────────────────────────────────────────
# Tokens are signed with this. CHANGE IT before deploying anywhere real.
LAUNCHPAD_AUTH_SECRET=launchpad-dev-secret-change-me

# Google sign-in ("Continue with Google" on /sign-in and /sign-up).
# All three are OPTIONAL. With none of them set, the app runs exactly as before
# on email/password plus the demo account, and the Google row says "not set up".
#
# Create both values at https://console.cloud.google.com/apis/credentials as an
# "OAuth 2.0 Client ID" of type "Web application", then add under that client:
#   Authorized JavaScript origins  http://localhost:5173  and  http://localhost:4000
#   Authorized redirect URIs       http://localhost:4000/api/auth/google/callback
# (plus your real domain in production). GOOGLE_CLIENT_SECRET is only needed for
# the redirect flow; the button itself works with the client id alone.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ── The examples row under the dashboard ─────────────────────────────────────
# Real sites, in three groups: what this API generated, a curated list, and
# Behance when a key exists. Nothing here is required to get a full row — the
# curated half is a file this repo owns, so an install with no credentials shows
# examples from the start. (The galleries this list is modelled on, Lapa Ninja
# first among them, answer a server with a Cloudflare challenge and publish no
# feed or API: measured 2026-09-06, every path 403. So they are click-out links
# in the row's header, which a browser handles fine and a fetch never will.)
LAUNCHPAD_EXAMPLES_SOURCE=auto        # auto · links · behance · off
LAUNCHPAD_EXAMPLES_FILE=              # blank means apps/api/examples.json
LAUNCHPAD_EXAMPLE_LIMIT=8             # curated cards per request, 12 at most
# How many of this API's own published sites share the row.
LAUNCHPAD_EXAMPLE_COUNT=4

# ── ...and from Behance, which usually is not possible ──────────────────────
# The one outside half that needs a credential. It is server-side on purpose —
# api.behance.net sends no CORS headers, so a browser cannot call it — and Adobe
# stopped issuing keys, so the honest default is "not configured": the row keeps
# working off the file above and says why the API half is missing. Read on
# request, cached, never able to stall the dashboard, and a failing call keeps the
# cards from the last good answer with a note instead of emptying the row. Never
# put a key in the frontend.
BEHANCE_API_KEY=
*** Whose work to show: a few designers, which is far better than the
# site-wide feed. Capped at four, one request each.
LAUNCHPAD_BEHANCE_USERS=
# Or the site-wide feed by field and sort: web-design, graphic-design, ui-ux…
LAUNCHPAD_BEHANCE_FIELD=
LAUNCHPAD_BEHANCE_SORT=appreciations
LAUNCHPAD_BEHANCE_PER_PAGE=8
# Never blocks the dashboard for longer than this, and the answer is cached.
LAUNCHPAD_BEHANCE_TIMEOUT_MS=6000
LAUNCHPAD_BEHANCE_TTL_MS=900000
# 'off' stops the calls even when a key exists; 'auto' (default) uses one if set.
LAUNCHPAD_INSPIRATION=auto

# ── Serving the built frontend from the API ───────────────────────────────────
# Set to 1 to have the API also serve apps/web/dist, so one service hosts the
# whole product (Render alone, a VPS, or a quick share on your LAN). Requests
# under /api and /uploads stay with the API; anything else falls back to the
# app shell. Leave unset for the usual split: Vite/preview in dev, a CDN or
# Vercel in production.
LAUNCHPAD_SERVE_WEB=

# ── Web dev server ────────────────────────────────────────────────────────────
# Only needed if the API is not on :4000 — Vite proxies /api and /uploads.
# LAUNCHPAD_API_ORIGIN=http://127.0.0.1:4000
